# Copie para .env.local (npm run setup gera automaticamente). Nunca commitar valores reais.

# Segredo para assinar a sessão (mín. 32 caracteres aleatórios)
SESSION_SECRET=

# Usuários: hash scrypt gerado por `npm run hash-password -- <senha>`
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
CLIENT_USERNAME=cliente
CLIENT_PASSWORD_HASH=

# Banco SQLite local (padrão: data/private/arto.db)
DATABASE_PATH=data/private/arto.db

# Planilha de origem para importação (padrão: data/private/ARTO_Caico_Orcamento_V4_Quantificacao_Integral.xlsx)
V4_XLSX_PATH=

# Protótipo anterior, usado só para relatório de divergências (opcional)
LEGACY_JSON_PATH=data/private/ARTO_Caico_MVP_dados.json

# Defina "1" apenas atrás de HTTPS (produção) para cookie Secure
COOKIE_SECURE=
